# Use free-tier accounts with billing disabled. No paid API or embedding service is needed.
GROQ_API_KEY=
GROQ_MODELS=
GEMINI_API_KEY=
GEMINI_MODELS=
# Optional comma-separated preferred model IDs. Blank = discover text models and rank by context window.
OLLAMA_URL=
OLLAMA_MODELS=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RERANK_ENABLED=true
DATA_DIR=data
CORS_ORIGINS=http://localhost:3000
# Set a long random token for a public backend, then enter it in the frontend connection dialog.
ACCESS_TOKEN=
MAX_REPO_MB=100
MAX_FILES=2000
MAX_CHUNKS=12000
MAX_REPOS=10
MIN_DENSE_SCORE=0.30
